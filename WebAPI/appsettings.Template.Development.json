//Tạo file appsettings.Devlopment.json từ file mẫu appsettings.Template.json và điền các thông tin cần thiết như sau:
{
	//Danh sách các máy chủ (hosts) được phép truy cập ứng dụng
	//Ví dụ: abc.online;www.abc.online;admin.abc.online;www.admin.abc.online
	//Nếu đang lập trình thì nên gõ là dấu *
	"AllowedHosts": "",
	//Cấu hình CORS (Cross-Origin Resource Sharing)
	"Cors": {
		"AllowedOrigins": "http://localhost:5173;http://localhost:3000;http://localhost:3001" //Gõ chính xác các url vào đây
	},
	//Chuỗi kết nối cơ sở dữ liệu
	"ConnectionStrings": {
		"StringConnection": ""
	},
	//Cấu hình xem môi trường cơ sở dữ liệu chạy là MS SQL Server ("SqlServer") hoặc MySQL ("MySql") hoặc PostgreSql ("PostgreSql")
	"Provider": "SqlServer",
	//Tên miền xuất cookie (Domain). Trống: localhost, có giá trị: sử dụng domain đó.
	"CookieDomain": "",
	//Cấu hình OpenTelemetry URL để gửi dữ liệu giám sát dự án khi chạy
	"OpenTelemetry": {
		"OtlpEndpoint": "http://localhost:4317"
	},
	//Thông tin ghi log Serilog
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.AspNetCore": "Warning",
				"Microsoft.EntityFrameworkCore.Database.Command": "Warning",
				"Microsoft.AspNetCore.Watch.BrowserRefresh": "Warning",
				"Microsoft.AspNetCore.Watch.BrowserRefresh.BlazorWasmHotReloadMiddleware": "Warning",
				"System.Net.Http.HttpClient": "Warning",
				"LuckyPennySoftware.MediatR.License": "Fatal"
			}
		}
	},
	//Cài đặt liên quan đến Token JWT
	"Jwt": {
		"Key": "", //JWT Key Bắt buộc dài hơn 32 kí tự
		"Issuer": "", //Địa chỉ API
		"Audience": "", //Địa chỉ nơi đến (client)
		"AccessTokenExpiryInMinutes": 540, //Thời gian hết hạn token (phút). Hết hạn thì bắt buộc phải lấy lại AccessToken từ RefreshToken.
		"RefreshTokenExpiryInDays": 90 //Thời gian hết hạn RefreshToken (ngày) nếu không lấy lại Access Token từ Refresh Token. Hết hạn thì bắt buộc phải đăng nhập lại.
	},
	//Người dùng được bảo vệ không xoá và roles đặc biệt không được phép xoá và full quyền
	"ProtectedAuthorizationEntities": {
		"SuperRoles": [""], //Roles đặc biệt không được phép xoá và full quyền
		"ProtectedUsers": ["example@example.com:Admin@123456"], //Format: "email:password" hoặc "email" (mật khẩu mặc định: DefaultProtectedUser@123456). Người dùng được bảo vệ không xoá
		"DefaultRolesForNewUsers": [""] //Roles mặc định được gán ngẫu nhiên cho người dùng mới
	},
	"SeedingOptions": {
		"RunDataSeedingOnStartup": false //Bật chế độ Seeding dữ liệu khi khởi động ứng dụng
	},
	//Cấu hình Đăng nhập bằng mạng xã hội (Google & Facebook)
	"Authentication": {
		"Google": {
			"ClientId": "", //Google Client ID
			"ClientSecret": "" //Google Client Secret
		},
		"Facebook": {
			"AppId": "", //Facebook App ID
			"AppSecret": "" //Facebook App Secret
		}
	},
	//Cấu hình VNPay
	"VNPay": {
		"TmnCode": "", //VNPay TmnCode
		"HashSecret": "", //VNPay HashSecret
		"BaseUrl": "", //URL thanh toán sandbox hoặc thật
		"CallbackUrl": "" //URL nhận kết quả thanh toán từ VNPay (Thường là URL của API Backend)
	},
	//Cấu hình PayOS
	"PayOS": {
		"ClientId": "", //PayOS Client ID
		"ApiKey": "", //PayOS API Key
		"ChecksumKey": "", //PayOS Checksum Key
		"BaseUrl": "", //URL API của PayOS
		"ReturnUrl": "", //URL redirect khi thanh toán xong
		"CancelUrl": "" //URL redirect khi hủy thanh toán
	},
	//Cấu hình lưu trữ tệp tin cục bộ
	"LocalFileStorage": {
		"UploadPath": "wwwroot/uploads" // BẮT BUỘC: Đường dẫn tuyệt đối hoặc tương đối để lưu trữ tệp. Ví dụ: "/var/www/uploads" hoặc "uploads"
	},
	//Cấu hình Giao Hàng Nhanh (GHN)
	"GhnSettings": {
		"Token": "", // API Token của GHN
		"ShopId": "", // Mã đối tác (Partner Code)
		"BaseUrl": "https://online-gateway.ghn.vn" // Base URL GHN
	},
	"AISetup": {
		"Provider": "OpenAI", // "OpenAI" hoặc "ApiEndpoint" (Ollama)
		"ApiEndpoint": "", // Với OpenAI: Base URL API (để trống dùng https://api.openai.com/v1). Với ApiEndpoint (Ollama): ví dụ "http://127.0.0.1:11434"
		"ApiKey": "", // Với OpenAI: API Key. Với ApiEndpoint (Ollama): để trống.
		"Model": "gpt-4o-mini", // Tên mô hình muốn sử dụng
		"LangSmithTracing": true,
		"LangSmithApiKey": "lsv2_pt_edaf041d7aef40bxxxxc_c5d7fe6aeb"
	},
	//Cấu hình Google Analytics 4 — CHỈ khai báo tại Backend, frontend/mobile lấy Measurement ID qua API
	"GoogleAnalytics4": {
		"PropertyId": "", //Property ID dạng số (Admin → Property Settings)
		"MeasurementId": "", //G-XXXXXXXXXX của web stream Store
		"ServiceAccount": {}, //Dán NGUYÊN nội dung object từ file JSON key Service Account tải về vào trong ngoặc này
		"MeasurementProtocolApiSecret": "" //API Secret Measurement Protocol (cho Mobile gửi sự kiện qua Backend)
	}
}
